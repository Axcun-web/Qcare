# Template konfigurasi. Salin menjadi .env lalu sesuaikan bila perlu:
#   cp .env.example .env
#
# Nilai default di bawah sudah cocok dengan docker-compose.yml,
# sehingga dapat langsung dipakai tanpa perubahan.

# ---- Server ----
NODE_ENV=development
PORT=4000

# Origin frontend yang diizinkan mengakses API (CORS)
CORS_ORIGIN=http://localhost:5173

# ---- Database (PostgreSQL) ----
# Port 5433 = container docker-compose (bukan PostgreSQL lokal di 5432).
DATABASE_URL="postgresql://qcare:qcare_dev@localhost:5433/qcare?schema=public"

# ---- Autentikasi (JWT) ----
# WAJIB diganti dengan string acak minimal 32 karakter untuk deployment.
# Bangkitkan dengan:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=ganti-dengan-secret-acak-minimal-32-karakter
JWT_EXPIRES_IN=1d

# ---- Layanan prediksi (FastAPI) ----
# Diaktifkan pada tahap integrasi model Random Forest.
PREDICTION_SERVICE_URL=http://localhost:8000
